# LLM Provider
LLM_PROVIDER=nvidia-nim          # or deepinfra
NVIDIA_NIM_API_KEY=
DEEPINFRA_API_KEY=
LLM_MODEL=meta/llama-3.3-70b-instruct

# Search Providers
BRAVE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=        # optional, works without auth
PERPLEXITY_API_KEY=

# Search routing override (optional JSON)
SEARCH_ROUTING_JSON=

# Vercel KV (Redis)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
